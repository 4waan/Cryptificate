import Cryptificate.Grain.Generator
import WideTrail.Poseidon2.BN254Parameters

/-!
# The pinned BN254 constants are the Grain constants

WideTrail pins the round constants of the BN254 width-three Poseidon2 instance
(`Poseidon2.BN254.roundConstants`, copied from HorizenLabs/poseidon2 at commit
`055bde3f4782731ba5f5ce5888a440a94327eaf3`, `poseidon2_instance_bn256.rs`, `RC3`). The kernel
evaluates `Grain.poseidon2Constants` for `p` the BN254 scalar field modulus, `t = 3`, `R_F = 8`,
`R_P = 56` and finds exactly those `64 × 3` numbers, read row by row.

This is both a test of the transcription against an independently published table and the
certificate of claim `constants.grain` for designs that use the profile's reference constants.
-/

set_option autoImplicit false

namespace Cryptificate.Grain

/-- WideTrail's pinned BN254 round constants as one list: round `r`, position `i` at `3r + i`,
each as its representative in `[0, p)`. -/
def bn254ReferenceFlat : List ℕ :=
  (List.finRange 64).flatMap fun r => (List.finRange 3).map fun i =>
    (Poseidon2.BN254.roundConstants r i).val

/-- **The pinned BN254 constants are generated by the Grain procedure** with the instance's
parameters. -/
theorem bn254_reference :
    poseidon2Constants Poseidon2.BN254.modulus 3 8 56 = some bn254ReferenceFlat := by
  decide +kernel

end Cryptificate.Grain
