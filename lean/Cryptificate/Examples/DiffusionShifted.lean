import Cryptificate

/-!
# Example: other offsets

The AES matrix with the offsets `1 2 3 0`, six rounds, and the S-box table `x ↦ x + 1 mod 256`
with its inverse. Any four distinct offsets are diffusion-optimal, so the bound is the same as
for AES: `25 + 5 = 30` at six rounds. (The S-box is a poor one, but the activity bound only
asks for injectivity.)

Instantiated by `scripts/instantiate.py` from the fragments `header`, `const_matrix_gf256`,
`const_offsets`, `const_rounds`, `const_sbox_table`, `const_sbox_inv`, `matrix_mds`,
`offsets_optimal`, `activity_bound`, `sbox_bijective` and `footer`.
-/

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 2000000

namespace CryptificateJob

open Cryptificate

/-- The candidate's `4 × 4` mixing matrix over `GF(2⁸)`, row-major as submitted. -/
def candMatrix : Matrix (Fin 4) (Fin 4) GF256 :=
  gfMat4 0x02 0x03 0x01 0x01 0x01 0x02 0x03 0x01 0x01 0x01 0x02 0x03 0x03 0x01 0x01 0x02

#eval Audit.echoInput "candMatrix" candMatrix

/-- The candidate's row offsets: `out[r][c] = in[r][(c + candOffsets r) mod 4]`, row `r`
rotated left by `candOffsets r`. -/
def candOffsets : Fin 4 → Fin 4 :=
  offsets4 1 2 3 0

#eval Audit.echoInput "candOffsets" candOffsets

/-- The candidate's number of rounds. -/
def candRounds : ℕ := 6

#eval Audit.echoInput "candRounds" candRounds

/-- The candidate's S-box: entry `x` of the submitted table is the image of the byte `x`. -/
def candSboxTable : GF256 → GF256 :=
