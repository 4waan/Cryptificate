{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4waan/Cryptificate/schemas/field-element.schema.json",
  "title": "Field element encodings",
  "$defs": {
    "gf256": {
      "description": "GF(2^8) element (polynomial 0x11B) as two hex digits; canonical output is uppercase without prefix.",
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{2}$"
    },
    "bn254": {
      "description": "BN254 scalar field element as a canonical decimal string in [0, p); no sign, whitespace or leading zeros. The range check against p is done by the validators.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,76})$"
    },
    "any": {
      "anyOf": [{ "$ref": "#/$defs/gf256" }, { "$ref": "#/$defs/bn254" }]
    },
    "gf256Matrix4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/gf256" } }
    },
    "bn254Matrix3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/bn254" } }
    }
  }
}
