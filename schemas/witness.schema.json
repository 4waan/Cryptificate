{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4waan/Cryptificate/schemas/witness.schema.json",
  "title": "Witness",
  "oneOf": [
    {
      "title": "Branch-number witness",
      "type": "object",
      "required": ["kind", "input", "output", "inputWeight", "outputWeight", "bound"],
      "properties": {
        "kind": { "const": "branch" },
        "input": { "type": "array", "items": { "$ref": "field-element.schema.json#/$defs/any" } },
        "output": { "type": "array", "items": { "$ref": "field-element.schema.json#/$defs/any" } },
        "inputWeight": { "type": "integer", "minimum": 0 },
        "outputWeight": { "type": "integer", "minimum": 0 },
        "bound": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "title": "Offset collision",
      "type": "object",
      "required": ["kind", "rows", "offset"],
      "properties": {
        "kind": { "const": "offset-collision" },
        "rows": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "offset": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "title": "Distinguishing input",
      "type": "object",
      "required": ["kind", "input", "expected", "actual", "differing"],
      "properties": {
        "kind": { "const": "distinguishing-input" },
        "input": { "type": "array", "items": { "$ref": "field-element.schema.json#/$defs/any" } },
        "expected": { "type": "array", "items": { "$ref": "field-element.schema.json#/$defs/any" } },
        "actual": { "type": "array", "items": { "$ref": "field-element.schema.json#/$defs/any" } },
        "differing": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    },
    {
      "title": "S-box collision",
      "type": "object",
      "required": ["kind", "x1", "x2", "y"],
      "properties": {
        "kind": { "const": "sbox-collision" },
        "x1": { "$ref": "field-element.schema.json#/$defs/gf256" },
        "x2": { "$ref": "field-element.schema.json#/$defs/gf256" },
        "y": { "$ref": "field-element.schema.json#/$defs/gf256" }
      }
    },
    {
      "title": "S-box differential uniformity",
      "type": "object",
      "required": ["kind", "uniformity", "inputDifference", "outputDifference"],
      "properties": {
        "kind": { "const": "sbox-differential" },
        "uniformity": { "type": "integer", "minimum": 0, "maximum": 256 },
        "inputDifference": { "$ref": "field-element.schema.json#/$defs/gf256" },
        "outputDifference": { "$ref": "field-element.schema.json#/$defs/gf256" }
      }
    },
    {
      "title": "S-box linearity",
      "type": "object",
      "required": ["kind", "linearity", "inputMask", "outputMask"],
      "properties": {
        "kind": { "const": "sbox-linearity" },
        "linearity": { "type": "integer", "minimum": 0, "maximum": 256 },
        "inputMask": { "$ref": "field-element.schema.json#/$defs/gf256" },
        "outputMask": { "$ref": "field-element.schema.json#/$defs/gf256" }
      }
    },
    {
      "title": "Power map collision",
      "type": "object",
      "required": ["kind", "exponent", "x1", "x2", "note"],
      "properties": {
        "kind": { "const": "power-collision" },
        "exponent": { "type": "integer", "minimum": 1 },
        "x1": { "$ref": "field-element.schema.json#/$defs/bn254" },
        "x2": { "$ref": "field-element.schema.json#/$defs/bn254" },
        "note": { "type": "string" }
      }
    },
    {
      "title": "Partial-round bypass",
      "description": "A nonzero difference that every power of the internal matrix below partialRounds keeps at zero on the masked positions, so it passes every partial round with no active S-box.",
      "type": "object",
      "required": ["kind", "difference", "positions", "partialRounds"],
      "properties": {
        "kind": { "const": "partial-bypass" },
        "difference": { "type": "array", "items": { "$ref": "field-element.schema.json#/$defs/bn254" } },
        "positions": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "partialRounds": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "title": "Kernel vector",
      "description": "A nonzero vector x with M x = 0 for the matrix M of the claim (the internal matrix for internal.invertible, the external matrix for external.invertible), so M is singular.",
      "type": "object",
      "required": ["kind", "vector"],
      "properties": {
        "kind": { "const": "kernel" },
        "vector": { "type": "array", "minItems": 1, "items": { "$ref": "field-element.schema.json#/$defs/bn254" } }
      }
    },
    {
      "title": "Round-constant mismatch",
      "description": "The first position (index = round * width + position, Poseidon2 layout) at which the submitted round constants differ from the ones the Grain procedure generates, with both values in decimal.",
      "type": "object",
      "required": ["kind", "index", "round", "position", "expected", "actual"],
      "properties": {
        "kind": { "const": "constant-mismatch" },
        "index": { "type": "integer", "minimum": 0 },
        "round": { "type": "integer", "minimum": 0 },
        "position": { "type": "integer", "minimum": 0 },
        "expected": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "actual": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
      }
    }
  ]
}
