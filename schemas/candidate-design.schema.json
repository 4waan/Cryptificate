{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4waan/Cryptificate/schemas/candidate-design.schema.json",
  "title": "CandidateDesign",
  "oneOf": [
    {
      "$ref": "#/$defs/aesLike"
    },
    {
      "$ref": "#/$defs/hades"
    },
    {
      "$ref": "#/$defs/hadesPrime"
    }
  ],
  "$defs": {
    "aesLike": {
      "title": "AES-like design over GF(2^8)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "field",
        "width",
        "matrix",
        "offsets",
        "rounds",
        "sbox"
      ],
      "properties": {
        "model": {
          "const": "aes-like/gf256/v1"
        },
        "field": {
          "const": "gf256"
        },
        "width": {
          "description": "4; widths 2 and 3 are accepted only with experimental: true.",
          "enum": [
            2,
            3,
            4
          ]
        },
        "matrix": {
          "description": "Row-major width x width matrix, y = M x.",
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "$ref": "field-element.schema.json#/$defs/gf256"
            }
          }
        },
        "offsets": {
          "description": "One offset per row: out[r][c] = in[r][(c + offsets[r]) mod width].",
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "rounds": {
          "type": "integer",
          "minimum": 4,
          "maximum": 32
        },
        "sbox": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "aes"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "table"
              ],
              "properties": {
                "kind": {
                  "const": "table"
                },
                "table": {
                  "type": "array",
                  "minItems": 256,
                  "maxItems": 256,
                  "items": {
                    "$ref": "field-element.schema.json#/$defs/gf256"
                  }
                }
              }
            }
          ]
        },
        "experimental": {
          "description": "Set by normalization for the experimental widths 2 and 3.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "width": {
                "enum": [
                  2,
                  3
                ]
              }
            }
          },
          "then": {
            "required": [
              "experimental"
            ],
            "properties": {
              "experimental": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "hades": {
      "title": "HADES design over the BN254 scalar field",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "field",
        "width",
        "external",
        "internal",
        "fullRounds",
        "partialRounds",
        "sbox",
        "partialMask",
        "constants"
      ],
      "properties": {
        "model": {
          "const": "hades/bn254/v1"
        },
        "field": {
          "const": "bn254"
        },
        "width": {
          "const": 3
        },
        "external": {
          "$ref": "field-element.schema.json#/$defs/bn254Matrix3"
        },
        "internal": {
          "$ref": "field-element.schema.json#/$defs/bn254Matrix3"
        },
        "fullRounds": {
          "description": "Even; half before and half after the partial rounds. fullRounds + partialRounds <= 160.",
          "type": "integer",
          "minimum": 0,
          "maximum": 160,
          "multipleOf": 2
        },
        "partialRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 160
        },
        "sbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "exponent"
          ],
          "properties": {
            "kind": {
              "const": "power"
            },
            "exponent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "partialMask": {
          "description": "S-box positions active in partial rounds.",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "boolean"
          }
        },
        "constants": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "reference"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "values"
              ],
              "properties": {
                "kind": {
                  "const": "explicit"
                },
                "values": {
                  "description": "One row per round; length must equal fullRounds + partialRounds.",
                  "type": "array",
                  "maxItems": 160,
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "$ref": "field-element.schema.json#/$defs/bn254"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "hadesPrime": {
      "title": "HADES design over a prime field below 2^64",
      "description": "Model hades/prime/v1. The field is one of four named primes or \"prime\" with an explicit modulus. Elements are canonical decimal strings in [0, p); the range check against p, primality of a custom modulus and the agreement of a given modulus with a named field are done by the validators. Normalization always states the modulus.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "field",
        "width",
        "external",
        "internal",
        "fullRounds",
        "partialRounds",
        "sbox"
      ],
      "properties": {
        "model": {
          "const": "hades/prime/v1"
        },
        "field": {
          "enum": [
            "babybear",
            "koalabear",
            "mersenne31",
            "goldilocks",
            "prime"
          ],
          "description": "babybear 2013265921, koalabear 2130706433, mersenne31 2147483647, goldilocks 18446744069414584321, or prime (custom, needs modulus)."
        },
        "modulus": {
          "description": "Decimal string of a prime below 2^64. Required for field \"prime\"; for a named field it must equal that field's modulus.",
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "width": {
          "description": "The Poseidon2 widths. Above 4 the external matrix's minors are not enumerated; see external.m4_mds and external.invertible.",
          "enum": [
            2,
            3,
            4,
            8,
            12,
            16,
            24
          ]
        },
        "external": {
          "$ref": "field-element.schema.json#/$defs/primeMatrix"
        },
        "internal": {
          "$ref": "field-element.schema.json#/$defs/primeMatrix"
        },
        "fullRounds": {
          "description": "Even; half before and half after the partial rounds. fullRounds + partialRounds <= 160.",
          "type": "integer",
          "minimum": 0,
          "maximum": 160,
          "multipleOf": 2
        },
        "partialRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 160
        },
        "sbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "exponent"
          ],
          "properties": {
            "kind": {
              "const": "power"
            },
            "exponent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "partialMask": {
          "description": "S-box positions active in partial rounds, one per state position; defaults to position 0 only.",
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": {
            "type": "boolean"
          }
        },
        "constants": {
          "description": "Defaults to unspecified: every claim holds for all round constants.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "unspecified"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "values"
              ],
              "properties": {
                "kind": {
                  "const": "explicit"
                },
                "values": {
                  "description": "One row per round; length must equal fullRounds + partialRounds.",
                  "type": "array",
                  "maxItems": 160,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 24,
                    "items": {
                      "$ref": "field-element.schema.json#/$defs/prime"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
