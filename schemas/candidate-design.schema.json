{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4waan/Cryptificate/schemas/candidate-design.schema.json",
  "title": "CandidateDesign",
  "oneOf": [{ "$ref": "#/$defs/aesLike" }, { "$ref": "#/$defs/hades" }],
  "$defs": {
    "aesLike": {
      "title": "AES-like design over GF(2^8)",
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "field", "width", "matrix", "offsets", "rounds", "sbox"],
      "properties": {
        "model": { "const": "aes-like/gf256/v1" },
        "field": { "const": "gf256" },
        "width": { "const": 4 },
        "matrix": { "$ref": "field-element.schema.json#/$defs/gf256Matrix4", "description": "Row-major, y = M x." },
        "offsets": {
          "description": "Row shift offsets: out[r][c] = in[r][(c + offsets[r]) mod 4].",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "integer", "minimum": 0, "maximum": 3 }
        },
        "rounds": { "type": "integer", "minimum": 4, "maximum": 32 },
        "sbox": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "aes" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "table"],
              "properties": {
                "kind": { "const": "table" },
                "table": {
                  "type": "array",
                  "minItems": 256,
                  "maxItems": 256,
                  "items": { "$ref": "field-element.schema.json#/$defs/gf256" }
                }
              }
            }
          ]
        }
      }
    },
    "hades": {
      "title": "HADES design over the BN254 scalar field",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "field",
        "width",
        "external",
        "internal",
        "fullRounds",
        "partialRounds",
        "sbox",
        "partialMask",
        "constants"
      ],
      "properties": {
        "model": { "const": "hades/bn254/v1" },
        "field": { "const": "bn254" },
        "width": { "const": 3 },
        "external": { "$ref": "field-element.schema.json#/$defs/bn254Matrix3" },
        "internal": { "$ref": "field-element.schema.json#/$defs/bn254Matrix3" },
        "fullRounds": {
          "description": "Even; half before and half after the partial rounds. fullRounds + partialRounds <= 160.",
          "type": "integer",
          "minimum": 0,
          "maximum": 160,
          "multipleOf": 2
        },
        "partialRounds": { "type": "integer", "minimum": 0, "maximum": 160 },
        "sbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "exponent"],
          "properties": {
            "kind": { "const": "power" },
            "exponent": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "partialMask": {
          "description": "S-box positions active in partial rounds.",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "boolean" }
        },
        "constants": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "reference" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "values"],
              "properties": {
                "kind": { "const": "explicit" },
                "values": {
                  "description": "One row per round; length must equal fullRounds + partialRounds.",
                  "type": "array",
                  "maxItems": 160,
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": { "$ref": "field-element.schema.json#/$defs/bn254" }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
